@{
    ViewBag.Title = "Sekiro";
    int grade = 7;
}

@section Header{
    <h1>Sekiro</h1>
}

@section Style{
   <link rel="stylesheet" href="~/css/GamePage.css"/>
}

<div class="mainPart">
    <div class="part">
        <img src="~/Images/Sekiro/Sekiro_Img1.jpg"/>
        <p class="description">
            Это хардкорный экшен от третьего лица от создателей Dark Souls и Bloodborne.
        </p>
    </div>
    <div class="part">
        <p class="description">
           Действие разворачивается в Японии эпохи Сэнгоку. Игрок управляет синоби по имени Волк, который спасает своего господина и мстит за отрубленную руку, замененную на протез с различными гаджетами
        </p>
        <img src="~/Images/Sekiro/Sekiro_Img2.png"/>
    </div>
    <div class="grade">
        <p class="gradeText">@grade/10</p>
        <img src="~/Images/Star.png" />
    </div>
</div>