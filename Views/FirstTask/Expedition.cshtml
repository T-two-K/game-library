@{
    ViewBag.Title = "Expedition 33";
    int grade = 10;
}

@section Header{
    <h1>Expedition 33</h1>
}

@section Style{
   <link rel="stylesheet" href="~/css/GamePage.css"/>
   <link rel="stylesheet" href="~/css/Expedition.css"/>
}

<div class="mainPart">
    <div class="part">
        <img src="~/Images/Expedition/Expedition33_Img1.jpg"/>
        <p class="description">
            Это сюжетная ролевая игра (CRPG) с уникальной пошаговой боевой системой и элементами реального времени.
        </p>
    </div>
    <div class="part">
        <p class="description">
           Сеттинг представляет собой мрачное фэнтези, вдохновленное французской Прекрасной эпохой
        </p>
        <img src="~/Images/Expedition/Expedition33_Img2.jpg"/>
    </div>
    <div class="grade">
        <p class="gradeText">@grade/10</p>
        <img src="~/Images/Star.png" />
    </div>
</div>